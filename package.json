{
  "name": "scout-off-backend",
  "version": "1.0.0",
  "description": "Backend API for ScoutOff \u2014 decentralized football scouting platform on Stellar",
  "main": "dist/index.js",
  "scripts": {
    "predev": "node scripts/validate-env.js",
    "dev": "node api.js && ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "node api.js && tsc",
    "prestart": "node scripts/validate-env.js",
    "start": "node api.js && node dist/index.js",
    "test": "node node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node node_modules/jest/bin/jest.js --watch",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts' --ext .ts",
    "loadtest": "ts-node --project tsconfig.scripts.json scripts/loadtest.ts",
    "seed": "ts-node --project tsconfig.scripts.json scripts/seed.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.48.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.1",
    "@opentelemetry/sdk-node": "^0.52.1",
    "@stellar/stellar-sdk": "12.1.0",
    "axios": "1.6.8",
    "better-sqlite3": "11.10.0",
    "compression": "^1.8.1",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.18.2",
    "form-data": "4.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "9.0.2",
    "node-fetch": "^2.7.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/compression": "^1.8.1",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "20.12.7",
    "@types/node-fetch": "^2.6.11",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autocannon": "^8.0.0",
    "dezalgo": "^1.0.4",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "lint-staged": "^15.4.3",
    "supertest": "7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.4.5"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "testMatch": [
          "**/tests/**/*.test.ts",
          "!**/tests/scripts/**"
        ],
        "setupFiles": [
          "<rootDir>/tests/setup.ts"
        ],
        "moduleNameMapper": {
          "^@paralleldrive/cuid2$": "<rootDir>/__mocks__/@paralleldrive/cuid2.js"
        },
        "globals": {
          "ts-jest": {
            "diagnostics": false
          }
        },
        "coverageThreshold": {
          "global": {
            "branches": 70,
            "functions": 70,
            "lines": 70,
            "statements": 70
          }
        }
      },
      {
        "displayName": "scripts",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "testMatch": [
          "**/tests/scripts/**/*.test.ts"
        ],
        "setupFiles": [
          "<rootDir>/tests/setup-shell.ts"
        ],
        "globals": {
          "ts-jest": {
            "diagnostics": false
          }
        }
      }
    ]
  }
}
